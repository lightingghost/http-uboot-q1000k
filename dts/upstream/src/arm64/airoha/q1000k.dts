/dts-v1/;

/* The vendor first-stage loader installs ATF here. */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "en7581.dtsi"

/ {
	model = "Quantum Fiber Q1000K";
	compatible = "quantum,q1000k", "centurylink,q1000k", "lumen,q1000k",
		     "airoha,an7581", "airoha,en7581";
	recovery-gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
	recovery-link-mdio = <&mdio_bus>;
	recovery-link-phy-addrs = <8>;
	recovery-green-led-gpios = <&en7581_pinctrl 33 GPIO_ACTIVE_LOW>;
	recovery-yellow-led-gpios = <&en7581_pinctrl 43 GPIO_ACTIVE_LOW>;

	aliases {
		serial0 = &uart1;
		led-boot = &led_status_red;
		led-failsafe = &led_status_blue;
		led-upgrade = &led_status_white;
		led-running = &led_status_green;
	};

	chosen {
		rootdisk = <&ubi_rootfs>;
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
		stdout-path = "serial0:115200n8";
		linux,usable-memory-range = <0x0 0x80200000 0x0 0x1fe00000>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-restart {
			label = "reset";
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status_green: led-status-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
		};

		led_status_blue: led-status-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		led_status_red: led-status-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 29 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_status_white: led-status-white {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
		};

		led-lan-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&en7581_pinctrl 33 GPIO_ACTIVE_LOW>;
		};

		led-lan-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_LAN;
			gpios = <&en7581_pinctrl 43 GPIO_ACTIVE_LOW>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};

		conf {
			pins = "gpio2";
			output-high;
		};
	};
};

&spi_nand {
	#address-cells = <1>;
	#size-cells = <1>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "vendor";
			reg = <0x00000000 0x00600000>;
			read-only;
		};

		partition@600000 {
			label = "chainloader";
			reg = <0x00600000 0x00100000>;
			read-only;
		};

		partition@700000 {
			label = "ubi";
			reg = <0x00700000 0x1b600000>;
			compatible = "linux,ubi";

			volumes {
				ubi-volume-ubootenv {
					volname = "ubootenv";

					nvmem-layout {
						compatible = "u-boot,env-redundant-bool";
					};
				};

				ubi-volume-ubootenv2 {
					volname = "ubootenv2";

					nvmem-layout {
						compatible = "u-boot,env-redundant-bool";
					};
				};

				ubi-volume-uboot {
					volname = "uboot";
				};

				ubi_rootfs: ubi-volume-fit {
					volname = "fit";
				};
			};
		};

		partition@1bd00000 {
			label = "art";
			reg = <0x1bd00000 0x00300000>;
			read-only;
		};

		partition@1c000000 {
			label = "reserved_bmt";
			reg = <0x1c000000 0x04000000>;
			read-only;
		};

		/* Read-only access to original DSD identifiers and PON calibration. */
		partition-stock-dsd@400000 {
			label = "dsd";
			reg = <0x00400000 0x00200000>;
			read-only;
		};
	};
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};
